# BUYaSOUL ONE SYSTEM - Environment Variables
# Copy to .env and fill in your values

# GSK Daemon Configuration
GSK_MCP_URL=http://127.0.0.1:3001
MCP_API_KEY=gsk-dev-key
GSK_ROOT=./gsk
GSK_PROJECT_ROOTS=.;./gsk
GSK_MODEL=auto/best-reasoning
# NINE_ROUTER_URL / NINE_ROUTER_API_KEY are now OPTIONAL.
# As of OPERATION GSK-HEART, GSK absorbs OmniRoute's routing logic directly into
# gsk/integration/ (provider catalog, AIQ routing, combos, resilience, guardrails).
# The daemon runs fully self-contained with zero external OmniRoute dependency.
# Set these ONLY if you intentionally keep a legacy external OmniRoute gateway.
NINE_ROUTER_URL=http://127.0.0.1:20128
NINE_ROUTER_API_KEY=
GSK_CREATIVE_AUTONOMY=1

# OmniRoute Configuration (OPTIONAL — OmniRoute service is deprecated in favor of GSK-HEART)
# Safe to leave unset. See gsk/docs/OMNIRROUTE_DEPRECATION.md for shutdown steps.
OMNIROUTE_URL=http://127.0.0.1:20128
OMNIROUTE_PORT=20128

# CPL (GenesisHost) Configuration
CPL_URL=http://127.0.0.1:3457
GENESIS_PORT=3457

# Workbench Configuration
WORKBENCH_PORT=3000
WORKBENCH_API_PORT=3001
VITE_API_URL=http://localhost:3001

# Soul Economy
SOUL_ECONOMY_PATH=./soul-economy

# Optional: API Keys for providers (if not using OmniRoute)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=