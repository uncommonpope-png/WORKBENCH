{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node setup.js && node dist/server.cjs",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron electron-main.cjs\"",
    "electron:build": "npm run build && electron-builder",
    "setup": "node setup.js",
    "postinstall": "node setup.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "main": "electron-main.cjs",
  "build": {
    "appId": "com.buyasoul.workbench",
    "productName": "BUYASOUL Workbench",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "public/**/*",
      ".transformers-cache/**/*",
      ".seshat-vectors/**/*",
      "profit-brain/**/*"
    ],
    "extraResources": [
      {
        "from": ".transformers-cache",
        "to": ".transformers-cache",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".seshat-vectors",
        "to": ".seshat-vectors",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "profit-brain",
        "to": "profit-brain",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.3",
    "dockview": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-pty": "^1.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "three": "^0.184.0",
    "tree-sitter-wasms": "^0.1.13",
    "vite": "^6.2.3",
    "web-tree-sitter": "^0.20.8",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.5.12",
    "@types/xterm": "^3.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "monaco-editor": "^0.56.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  }
}
