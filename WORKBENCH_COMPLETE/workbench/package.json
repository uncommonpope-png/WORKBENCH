{
  "name": "buyasoul-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "setup": "node setup.js",
    "postinstall": "node setup.js",
    "lint": "tsc --noEmit"
  },
  "main": "electron-main.cjs",
  "build": {
    "appId": "com.buyasoul.workbench",
    "productName": "BUYASOUL Workbench",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "profit-brain/**/*"
    ],
    "extraResources": [
      {
        "from": ".transformers-cache",
        "to": ".transformers-cache",
        "filter": ["**/*"]
      },
      {
        "from": ".seshat-vectors",
        "to": ".seshat-vectors",
        "filter": ["**/*"]
      },
      {
        "from": "profit-brain",
        "to": "profit-brain",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.3",
    "dockview": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-pty": "^1.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "three": "^0.184.0",
    "tree-sitter-wasms": "^0.1.13",
    "vite": "^6.2.3",
    "web-tree-sitter": "^0.20.8",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.5.12",
    "@types/xterm": "^3.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "monaco-editor": "^0.56.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}