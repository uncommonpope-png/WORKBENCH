# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SLACK_WEBHOOK_URL: Required for outbound real-world Slack push alerts.
SLACK_WEBHOOK_URL=""

# HUBSPOT_API_KEY: Required for HubSpot contract transaction and lead updates.
HUBSPOT_API_KEY=""

# PINECONE_API_KEY: Required for live Pinecone index operations.
PINECONE_API_KEY=""

# SHOPIFY_ADMIN_ACCESS_TOKEN: Required for real Shopify order logistics fetch.
SHOPIFY_ADMIN_ACCESS_TOKEN=""

# SOLANA_RPC_URL: Required for querying live Decentrialized RPC networks if set.
SOLANA_RPC_URL=""
